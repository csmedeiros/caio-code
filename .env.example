# Copie para .env e preencha. Nunca versione o .env.

# Linear (obrigatório para os cards e para o hook de progresso)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=

# Modelo do agente
CAIO_CODE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Caminho do repositório da monografia (usado pela skill tcc-research-writing)
TCC_HOME=/root/tcc

# Desliga os hooks de fim de sessão quando necessário (1 = desligado)
TCC_SKIP_SESSION_HOOKS=0
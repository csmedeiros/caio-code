# Copie para .env e preencha. Nunca versione o .env.
# Nenhum valor de segredo pode aparecer em log, PR, comentário ou transcript.

# ---------------------------------------------------------------------------
# Linear (cards, subtarefas e o hook de progresso)
# ---------------------------------------------------------------------------
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=

# ---------------------------------------------------------------------------
# Provedor do agente (lido por caio_code/config.py: load_settings)
# ---------------------------------------------------------------------------
# stub | openai_compatible. O default é stub: offline e determinístico.
# TypeSafe NÃO é provedor de chat: o Jev é um modelo de decisão (ADR 0005),
# configurado em CAIO_CODE_DECISION_* abaixo.
CAIO_CODE_PROVIDER=stub
CAIO_CODE_MODEL=qwen3.8-max
# Modelo auxiliar (compactação, seleção por modelo, guardrails). Mais barato.
CAIO_CODE_AUX_PROVIDER=
CAIO_CODE_AUX_MODEL=qwen3.8-flash

# Endpoint compatível com OpenAI (usado por CAIO_CODE_PROVIDER=openai_compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Modelo de decisão TypeSafe (Jev) — ADR 0005. NÃO é modelo de chat.
# ---------------------------------------------------------------------------
# TYPESAFE_API_KEY é exigida apenas pelo modelo de decisão (provider typesafe).
TYPESAFE_API_KEY=
# Opcional; default do SDK: https://api.typesafe.ai (requisições vão a /v1/systemone).
TYPESAFE_BASE_URL=
# stub | typesafe. Default: typesafe se TYPESAFE_API_KEY existe, senão stub.
CAIO_CODE_DECISION_PROVIDER=
CAIO_CODE_DECISION_MODEL=jev-latest
# Override da base URL do modelo de decisão (default: TYPESAFE_BASE_URL).
CAIO_CODE_DECISION_BASE_URL=
CAIO_CODE_DECISION_TIMEOUT_SECONDS=60
# Tetos de custo do scorer de decisão: o estado é reenviado por batch.
CAIO_CODE_DECISION_STATE_CHAR_CAP=600
CAIO_CODE_DECISION_QUESTIONS_PER_REQUEST=40
CAIO_CODE_DECISION_RELEVANCE_THRESHOLD=0.5
CAIO_CODE_DECISION_RISK_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Janela e políticas de contexto (o objeto de medição do Capítulo 4)
# ---------------------------------------------------------------------------
CAIO_CODE_WINDOW_TOKENS=8000
CAIO_CODE_CONTEXT_LIMIT=128000
CAIO_CODE_WINDOW_BUFFER=20000
CAIO_CODE_ENFORCE_WINDOW=0
CAIO_CODE_COMPACTION_KEEP_TOKENS=8000
CAIO_CODE_SUMMARY_MAX_TOKENS=4096
CAIO_CODE_TOOL_RESULT_CHAR_CAP=2000
CAIO_CODE_COMPACTION_HEAD_CHAR_CAP=100000
CAIO_CODE_AUTO_COMPACT=1
CAIO_CODE_TOOL_MAX_LINES=2000
CAIO_CODE_TOOL_MAX_BYTES=51200
CAIO_CODE_TOKEN_COUNTER=char_proxy

# ---------------------------------------------------------------------------
# Tempos e tentativas do provedor
# ---------------------------------------------------------------------------
CAIO_CODE_TIMEOUT_SECONDS=120
CAIO_CODE_AUX_TIMEOUT_SECONDS=300
CAIO_CODE_MAX_RETRIES=2
CAIO_CODE_MAX_OUTPUT_TOKENS=4096
CAIO_CODE_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Sandbox das ferramentas
# ---------------------------------------------------------------------------
CAIO_CODE_ROOT=
CAIO_CODE_ALLOW_EXECUTE=1

# ---------------------------------------------------------------------------
# Experimento (caio-code evaluate)
# ---------------------------------------------------------------------------
CAIO_CODE_EVAL_DATASET=evals/datasets/long_histories
CAIO_CODE_EVAL_REPORTS=.reports/evals
CAIO_CODE_EVAL_REPETITIONS=3
CAIO_CODE_EVAL_MAX_CASES=5

# Chat-replay (v5): `caio-code evaluate --variants full,spill`
CAIO_CODE_PROBE_TOOL_CALL_CAP=3
CAIO_CODE_JUDGE_PROMPT=evals/prompts/judge_v1.md
CAIO_CODE_JUDGE_MIN_AGREEMENT=0.90

# ---------------------------------------------------------------------------
# Rastreamento no LangSmith (opcional; sem chave o tracing fica desligado)
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=caio-code
CAIO_CODE_LANGSMITH_UPLOAD=0

# ---------------------------------------------------------------------------
# Diversos
# ---------------------------------------------------------------------------
CAIO_CODE_SYSTEM_PROMPT=
# Caminho do repositório da monografia (usado pelas skills de pesquisa/escrita)
TCC_HOME=/root/tcc
# Desliga os hooks de fim de sessão quando necessário (1 = desligado)
TCC_SKIP_SESSION_HOOKS=0
